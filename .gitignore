# Virtual environments
venv/
.venv/
env/
.env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Pytest cache
.pytest_cache/
.coverage
htmlcov/

# Streamlit secrets
.streamlit/secrets.toml

# DuckDB database (regenerated by pipeline)
database/*.duckdb
database/*.duckdb.wal

# Large raw data files (place in data/raw/ but don't commit)
data/raw/*.csv
data/raw/*.parquet
data/raw/*.json

# Processed data remains local; only the reviewed dashboard artifacts are published.
data/processed/
data/output/*
!data/output/category_analytics.parquet
!data/output/churn_feature_importance.parquet
!data/output/churn_predictions.parquet
!data/output/cohort_retention.parquet
!data/output/customer_clv.parquet
!data/output/customer_rfm.parquet
!data/output/customer_segments.parquet
!data/output/monthly_kpis.parquet
!data/output/recommendations.parquet

# Model artifacts (can be regenerated)
models/*.pkl
models/*.joblib

# IDE files
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temp files
*.tmp
*.temp
