# Virtual environments
venv/
.venv/
env/
.env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Pytest cache
.pytest_cache/
.coverage
htmlcov/

# Streamlit secrets
.streamlit/secrets.toml

# DuckDB database (regenerated by pipeline)
database/*.duckdb
database/*.duckdb.wal

# Large raw data files (place in data/raw/ but don't commit)
data/raw/*.csv
data/raw/*.parquet
data/raw/*.json

# Processed and output data (regenerated by pipeline)
data/processed/
data/output/

# Model artifacts (can be regenerated)
models/*.pkl
models/*.joblib

# IDE files
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temp files
*.tmp
*.temp
